    { "name": "case_folding_collision", "base": "skill", "mutations": [{ "op": "add_entry", "entry": { "path": "payload/skill.md", "kind": "regular", "executable": false, "sha256": "sha256:2630b3e6646cf6d7fbaba9e032db715b195899975227517f998b32235dca1f4c", "content": "print('fixture only; never executed')\n" } }], "expected": ["extra_file", "path_collision"] },
