# Typed exact-cohort policy for the optional ATIF-v1.7 adapter.
let NonEmpty = std.contract.from_predicate (fun value => std.is_string value && value != "") in
let Positive = std.contract.from_predicate (fun value => std.is_number value && value > 0) in
let Blake3Identity = std.contract.from_predicate (fun value => std.is_string value && std.string.is_match "^b3:[0-9a-f]{64}$" value) in
let Disposition = NonEmpty in
let Bounds = {
  max_input_bytes | Positive,
  max_trajectories | Positive,
  max_depth | Positive,
  max_steps | Positive,
  max_aggregate_steps | Positive,
  max_string_bytes | Positive,
  max_content_parts | Positive,
  max_tool_definitions | Positive,
  max_tool_calls | Positive,
  max_observation_results | Positive,
  max_subagent_refs | Positive,
  max_token_items | Positive,
  max_metrics_entries | Positive,
  max_extension_nodes | Positive,
  max_extension_depth | Positive,
  max_extension_bytes | Positive,
  max_loss_classes | Positive,
} in
let Projection = {
  messages | Disposition,
  reasoning | Disposition,
  tool_arguments | Disposition,
  tool_results | Disposition,
  images | Disposition,
  token_ids | Disposition,
  logprobs | Disposition,
  notes | Disposition,
  provider_model | Disposition,
  extensions | Disposition,
  copied_context_dataset | Disposition,
} in
let ExportDefaults = {
  invent_timestamps | Bool,
  invent_metrics | Bool,
  invent_reasoning | Bool,
  invent_tool_outcomes | Bool,
  invent_external_resources | Bool,
  invent_copied_context | Bool,
  invent_llm_call_count | Bool,
  invent_terminal_state | Bool,
} in
let Profile = {
  schema | NonEmpty,
  profile_id | NonEmpty,
  harbor_release | NonEmpty,
  harbor_revision | NonEmpty,
  atif_schema | NonEmpty,
  codec_identity | NonEmpty,
  source_cohort_identity | Blake3Identity,
  source_repository | NonEmpty,
  source_license | NonEmpty,
  source_paths | Array NonEmpty,
  bounds | Bounds,
  projection | Projection,
  external_references | NonEmpty,
  extension_scalar_allowlist | Array NonEmpty,
  receipt_fields | Array NonEmpty,
  required_non_claims | Array NonEmpty,
  export_defaults | ExportDefaults,
  ambient_resolution | Bool,
  automatic_persistence | Bool,
  automatic_dataset_promotion | Bool,
  automatic_evaluation_promotion | Bool,
} in
let input_bytes = 4194304 in
let trajectory_count = 256 in
let graph_depth = 16 in
let local_steps = 4096 in
let aggregate_steps = 16384 in
let string_bytes = 262144 in
let local_items = 512 in
let token_items = 262144 in
let extension_nodes = 16384 in
let extension_bytes = 1048576 in
let loss_classes = 32 in
{
  harbor_atif_profile | Profile = {
    schema = "animus.harbor-atif-profile.v1",
    profile_id = "animus.harbor-atif-v1_7.v1",
    harbor_release = "v0.18.0",
    harbor_revision = "527d50deb63a5d279e8c20593c18a2cbc7f61f9e",
    atif_schema = "ATIF-v1.7",
    codec_identity = "animus.harbor-atif-json-codec.v1",
    source_cohort_identity = "b3:78d4a45481206483c89269eeb515854552bb4185b4db41a966047d8f124cfe4f",
    source_repository = "laude-institute/harbor",
    source_license = "Apache-2.0",
    source_paths = [
      "rfcs/0001-trajectory-format.md",
      "src/harbor/models/trajectories",
      "src/harbor/utils/trajectory_validator.py",
      "tests/golden",
    ],
    bounds = {
      max_input_bytes = input_bytes,
      max_trajectories = trajectory_count,
      max_depth = graph_depth,
      max_steps = local_steps,
      max_aggregate_steps = aggregate_steps,
      max_string_bytes = string_bytes,
      max_content_parts = local_items,
      max_tool_definitions = local_items,
      max_tool_calls = local_items,
      max_observation_results = local_items,
      max_subagent_refs = local_items,
      max_token_items = token_items,
      max_metrics_entries = local_items,
      max_extension_nodes = extension_nodes,
      max_extension_depth = graph_depth,
      max_extension_bytes = extension_bytes,
      max_loss_classes = loss_classes,
    },
    projection = {
      messages = "include",
      reasoning = "omit",
      tool_arguments = "omit",
      tool_results = "redact",
      images = "unresolved",
      token_ids = "omit",
      logprobs = "omit",
      notes = "omit",
      provider_model = "hash",
      extensions = "omit",
      copied_context_dataset = "reject",
    },
    external_references = "unresolved",
    extension_scalar_allowlist = ["trace_class", "producer_class"],
    receipt_fields = [
      "cohort",
      "profile_identity",
      "codec_identity",
      "direction",
      "status",
      "semantic_identity",
      "projection_identity",
      "wire_identity",
      "bounded_counts",
      "loss_classes",
      "disposition_classes",
      "non_claims",
      "receipt_identity",
    ],
    required_non_claims = [
      "not_live_correctness",
      "not_confinement",
      "not_durability",
      "not_exactly_once_effects",
      "not_verifier_soundness",
      "not_artifact_authenticity",
      "not_benchmark_validity",
      "not_training_fitness",
      "not_authoritative_completion",
      "not_production_readiness",
      "not_release_eligibility",
    ],
    export_defaults = {
      invent_timestamps = false,
      invent_metrics = false,
      invent_reasoning = false,
      invent_tool_outcomes = false,
      invent_external_resources = false,
      invent_copied_context = false,
      invent_llm_call_count = false,
      invent_terminal_state = false,
    },
    ambient_resolution = false,
    automatic_persistence = false,
    automatic_dataset_promotion = false,
    automatic_evaluation_promotion = false,
  },
}
