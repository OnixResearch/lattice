{
  "authority": {
    "environment_policy": "animus-pueue-env",
    "owner_label": "animus-pueue-host",
    "profile_source_label": "animus-pueue-profiles",
    "timeout_policy": "animus-pueue-timeout"
  },
  "bounds": {
    "command_timeout_ms": 30000,
    "daemon_timeout_ms": 5000,
    "max_backend_stderr_bytes": 1048576,
    "max_backend_stdout_bytes": 1048576,
    "max_log_bytes": 65536,
    "max_log_lines": 1000,
    "poll_interval_ms": 50,
    "task_kill_after_seconds": 5,
    "teardown_timeout_ms": 2000,
    "wait_poll_attempts": 80
  },
  "capabilities": {
    "interactions": [
      "wait",
      "poll"
    ]
  },
  "executables": {
    "pueue": "/run/current-system/sw/bin/pueue",
    "pueued": "/run/current-system/sw/bin/pueued",
    "timeout": "/run/current-system/sw/bin/timeout"
  },
  "namespace": {
    "config_leaf": "pueue.yml",
    "id": "animus-pueue-fixture",
    "root": "/tmp/animus-pueue-fixture"
  },
  "non_claims": [
    "command_correctness",
    "scheduler_reliability",
    "sandboxing",
    "production_readiness",
    "release_eligibility"
  ],
  "process_policy": {
    "allowed_cwd_prefixes": [
      "/tmp"
    ],
    "allowed_env_prefixes": [
      "ANIMUS_"
    ],
    "max_log_bytes": 1048576,
    "max_timeout_seconds": 3600
  },
  "profiles": [
    {
      "args": [],
      "backend": "pueue",
      "cwd": "/tmp",
      "env": [
        {
          "key": "ANIMUS_TASK",
          "value": "fixture"
        }
      ],
      "log_bytes": 1048576,
      "metadata": [
        {
          "key": "identity.class",
          "value": "fixture"
        }
      ],
      "name": "fixture-check",
      "notify_on_complete": false,
      "program": "/run/current-system/sw/bin/true",
      "timeout_seconds": 3600
    }
  ],
  "schema": "animus.pueue-host.v1"
}
