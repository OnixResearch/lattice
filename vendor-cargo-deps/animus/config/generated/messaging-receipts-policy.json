  "receipt_fields": [
    "policy_identity",
    "roster_identity",
    "sender_identity",
    "target_count",
    "mode",
    "variant",
    "counter_identity"
  ],
  "roles": [
    {
      "modes": [
        "auto",
        "steer",
        "follow_up"
      ],
      "role": "root"
    },
    {
      "modes": [
        "auto",
        "follow_up"
      ],
      "role": "subagent"
    }
  ],
  "roster_bound": true,
  "schema": "animus.messaging-receipts.v1",
